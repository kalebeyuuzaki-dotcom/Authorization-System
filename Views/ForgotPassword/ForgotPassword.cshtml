@model Portifolio.Models.ViewModels.EmailViewModel

@{
    if (TempData["ErrorMessage"] is not null)
    {
        <div>
            <span class="fw-semibold text-danger d-block mb-1">Erro de autenticação</span>
            @TempData["ErrorMessage"]
        </div>
    }
}

<form asp-controller="ForgotPassword" asp-action="PasswordRecoverEmail" method="Post">
    <div>
        <div class="text text-center">
            <h1>Esqueceu sua senha?</h1>
            <p>Insira seu endereço de e-mail para recuperar sua senha.</p>
        </div>
        <div class="form-group" style="max-width: 500px;">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" class="form-control" aria-describedby="emailHelp" placeholder="seu@email.com">
            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
        </div>
        <br />
        <button type="submit" class="btn btn-primary">Continuar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}