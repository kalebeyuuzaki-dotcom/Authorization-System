@model Portifolio.Models.ViewModels.LoginViewModel

@{
    TempData["Title"] = "Login";
}

<div class="m-auto text-start" style="max-width: 600px;">

    <h2 class="display-6 mb-4 text-center">Entrar no sistema</h2>
     
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3 text-center" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <form asp-controller="Login" asp-action="Authenticate" method="post">

        <!-- Campo: E-mail -->
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="seu@email.com" />
            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
        </div>

        <!-- Campo: Senha -->
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Senha</label>
            <input asp-for="Password" class="form-control" placeholder="Sua senha" />
            <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
        </div>

        <!-- Ações do Formulário -->
        <div class="d-grid gap-2 mb-3">
            <button class="btn btn-primary" type="submit">Entrar</button>
        </div>

    </form>

    <!-- Links de Suporte -->
    <div class="text-center">
        <p class="mb-3">
            <a asp-controller="Login" asp-action="Recover" class="text-decoration-none">Esqueci minha senha</a>
        </p>
        
        <hr />
        
        <p class="text-secondary mb-2">Não tem uma conta?</p>
        
        <div class="d-grid gap-2">
            <a asp-controller="Login" asp-action="Register" class="btn btn-outline-secondary">Criar nova conta</a>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
