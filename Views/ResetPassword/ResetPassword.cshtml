@model Portifolio.Models.ViewModels.ResetPasswordViewModel

@{
    dynamic erroMessage = ViewBag.ErrorMessage;
    if (erroMessage != null)
    {
        <div class="border-0 border-start border-4 border-danger ps-3 mb-4 small text-start text-dark bg-transparent"
             role="alert">
            <span class="fw-semibold text-danger d-block mb-1">Erro de verificação</span>
            @erroMessage
        </div>
    }
}

<form asp-controller="ResetPassword" asp-action="SaveNewPassword" method="post">
    <div class="form-group">
        <label asp-for="NewPassword">Nova senha</label>
        <input asp-for="NewPassword" class=" form-control" placeholder="Sua nova senha">
        <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword">Confirmar Senha</label>
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirme sua nova senha">
        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}